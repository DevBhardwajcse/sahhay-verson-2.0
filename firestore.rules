rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'devbhardwaj95.gmail.com@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'preferredLanguage',
        'consentMedicalHistory',
        'consentSaveSessions',
        'consentVoiceTranscripts',
        'retentionDays',
        'patientRefId',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'preferredLanguage',
        'consentMedicalHistory',
        'consentSaveSessions',
        'consentVoiceTranscripts',
        'retentionDays',
        'ageGroup',
        'allergiesSummary',
        'conditionsSummary',
        'medicationsSummary',
        'patientRefId',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId
      && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
      && (!('email' in data) || (data.email is string && data.email.size() <= 200))
      && data.preferredLanguage in ['en', 'hi']
      && data.consentMedicalHistory is bool
      && data.consentSaveSessions is bool
      && data.consentVoiceTranscripts is bool
      && data.retentionDays is int && data.retentionDays >= 1 && data.retentionDays <= 365
      && (!('ageGroup' in data) || (data.ageGroup is string && data.ageGroup.size() <= 40))
      && (!('allergiesSummary' in data) || (data.allergiesSummary is string && data.allergiesSummary.size() <= 500))
      && (!('conditionsSummary' in data) || (data.conditionsSummary is string && data.conditionsSummary.size() <= 500))
      && (!('medicationsSummary' in data) || (data.medicationsSummary is string && data.medicationsSummary.size() <= 500))
      && data.patientRefId is string && data.patientRefId.size() >= 4 && data.patientRefId.size() <= 40 && data.patientRefId.matches('^[A-Z0-9\\-]+$')
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidSavedSession(data, sessionId) {
      return data.keys().hasAll([
        'sessionId',
        'userId',
        'patientRefId',
        'sessionType',
        'language',
        'title',
        'summary',
        'urgencyLevel',
        'explicitConsent',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'sessionId',
        'userId',
        'patientRefId',
        'sessionType',
        'language',
        'title',
        'summary',
        'urgencyLevel',
        'consentedTranscript',
        'explicitConsent',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 && data.sessionId == sessionId
      && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
      && data.patientRefId is string && data.patientRefId.size() >= 4 && data.patientRefId.size() <= 40
      && data.sessionType in ['general_chat', 'medicine_scan', 'injury_analysis', 'guided_triage', 'voice_session']
      && data.language in ['en', 'hi']
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
      && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 4000
      && data.urgencyLevel in ['routine', 'soon', 'urgent', 'emergency']
      && (!('consentedTranscript' in data) || (data.consentedTranscript is string && data.consentedTranscript.size() <= 6000))
      && data.explicitConsent is bool && data.explicitConsent == true
      && data.status in ['active', 'archived']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data, logId) {
      return data.keys().hasAll([
        'logId',
        'adminUid',
        'adminLabel',
        'action',
        'targetRefId',
        'details',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'logId',
        'adminUid',
        'adminLabel',
        'action',
        'targetRefId',
        'details',
        'createdAt'
      ])
      && data.logId is string && data.logId.size() >= 1 && data.logId.size() <= 128 && data.logId == logId
      && data.adminUid is string && data.adminUid.size() >= 1 && data.adminUid.size() <= 128 && data.adminUid == request.auth.uid
      && data.adminLabel is string && data.adminLabel.size() >= 1 && data.adminLabel.size() <= 100
      && data.action in ['view_dashboard', 'view_patient', 'update_record', 'delete_record', 'export_record', 'login', 'logout']
      && data.targetRefId is string && data.targetRefId.size() >= 1 && data.targetRefId.size() <= 128
      && data.details is string && data.details.size() >= 1 && data.details.size() <= 500
      && data.createdAt is timestamp;
    }

    // 1. User Profiles (Strict PII Isolation)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().patientRefId == existing().patientRefId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'preferredLanguage',
              'consentMedicalHistory',
              'consentSaveSessions',
              'consentVoiceTranscripts',
              'retentionDays',
              'ageGroup',
              'allergiesSummary',
              'conditionsSummary',
              'medicationsSummary',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 2. Consented Saved Medical Sessions
    match /saved_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && (
        (isSignedIn() && existing().userId == request.auth.uid) || isAdmin()
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(sessionId)
        && isValidSavedSession(incoming(), sessionId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(sessionId)
        && isValidSavedSession(incoming(), sessionId)
        && incoming().sessionId == existing().sessionId
        && incoming().userId == existing().userId
        && incoming().patientRefId == existing().patientRefId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().userId == request.auth.uid
            && existing().status != 'archived'
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(sessionId) && (
        (isSignedIn() && existing().userId == request.auth.uid) || isAdmin()
      );
    }

    // 3. Append-Only Administrative Audit Logs
    match /admin_audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(logId)
        && isValidAuditLog(incoming(), logId)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 4. Trusted Admin Registry (No Client Writes)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list, write: if false;
    }
  }
}
