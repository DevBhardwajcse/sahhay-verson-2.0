# GEMINI_API_KEY: Required for server-side Gemini AI API calls (never expose to browser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Server-side key for Google Places API (New), Geocoding, and Routes proxy.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: Browser-restricted Maps JavaScript API key for interactive map rendering.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# SAHAAY_ADMIN_PASSCODE: Optional deployment passcode for the 'dev admin' portal (overrides first-run claim setup).
SAHAAY_ADMIN_PASSCODE=""

# APP_URL: Hosted application URL injected at runtime.
APP_URL="MY_APP_URL"
